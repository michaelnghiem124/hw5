# Copy to .env and fill in real values. NEVER commit the real .env — it is gitignored.
#
# The backend also reads ~/.config/mgt409/.env first (shared across this course's
# projects), then a local .env, without overriding anything already set in the
# environment. Either location works.

# --- Model provider -------------------------------------------------------
# "portkey"   -> gpt-6-luna through the Portkey gateway (what the assignment specifies)
# "anthropic" -> Claude (fallback used while no Portkey key is available)
#
# If unset, the provider is chosen automatically: portkey when PORTKEY_API_KEY is
# present, otherwise anthropic.
MODEL_PROVIDER=anthropic

# Required when MODEL_PROVIDER=portkey.
PORTKEY_API_KEY=pk-your-portkey-key-here
PORTKEY_MODEL=gpt-6-luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Required when MODEL_PROVIDER=anthropic.
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-sonnet-4-6
